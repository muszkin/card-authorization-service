{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git commit --amend*)",
      "Bash(git rebase*)",
      "Read(**/.env*)"
    ]
  }
}
